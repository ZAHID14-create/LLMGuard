# LLMGuard Backend Environment Configuration Template - Phase 8
PROJECT_NAME="LLMGuard – AI Evaluation & Safety Monitoring Platform"
API_VERSION="0.8.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Google AI Studio (Gemini API) Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"
EVALUATION_MODEL="gemini-2.5-flash"

# DeepEval Metric Thresholds
FAITHFULNESS_THRESHOLD=0.7
ANSWER_RELEVANCY_THRESHOLD=0.7
HALLUCINATION_THRESHOLD=0.7

# Guardrails AI Settings - Phase 4
MAX_INPUT_LENGTH=4000
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true

# Langfuse Observability Configuration - Phase 5
# Official platform: https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
